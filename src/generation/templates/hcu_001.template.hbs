<html>
    <head>
      <meta charset='UTF-8' />
	  <style>
      @page { 
        counter-reset: page 0;
      }
      body {
        background-color: white;
        color: black;
        font-size: 8px;
        font-family: arial;
        margin: 1px;
        padding: 1px;
      }
      main {
        padding-bottom: 30px;
      }
      footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0 20px;
        height: 20px;
        display: flex;
        justify-content: space-between;
        font-weight: bold;
        background-color: white;
      }
      .page::after {
        content: counter(page);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 1px;
        border: 2px solid black;
        table-layout: auto;
      }

      .table2 {
        table-layout: unset;
      }
      img {
        max-height: 100px;
        width: auto;
      }

      td {
        min-width: 8px;
        text-align: center;
        border: 1px solid black;
        height: 8px;      
        }

      th {
        width: auto;
        text-align: center;
        border: 1px solid black;
        height: 10px;
        font-weight: bold;
        white-space: nowrap;
      }

			.thV {
        background-color: #ccffff;
        font-weight: bold;
        text-align: center;
        height: 100px;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        white-space: nowrap;
    }

      .th1 {
        text-align: left;
        font-size: 9px;
        background-color: #ccccff;
      }
      .th2 {
        background-color: #ccffcc;
      }

      .th3 {
        background-color: white;
      }
      .th4 {
        background-color: #ccffcc;
        width: 5px;
        text-align: center;
      }
      .th5 {
        background-color: #ccffff;
        width: 5px;
        text-align: center;
      }

      .td1 {
        text-align: left;
        /*width: max-content;*/
        white-space: nowrap;
      }

	  .td2 {
        text-align: left;
        /*width: max-content;*/
        white-space: nowrap;
		background-color: #ccffcc;
      }

      .td4j {
        height: 90px;
        text-align: justify;
        vertical-align: top;
      }

      .document__admision,
      .document__admision__a,
      .document__admision__b,
      .document__admision__c,
      .document__admision__d,
			.document__admision__e,
			.document__admision__f,
			.document__admision__lista {
        width: 100%;
        margin-top: 5px;
        padding: 0;
      }
</style>
</head>
<body>
    <header></header>
    <main>
      <div class='document__admision'>
				<div class='document__admision__a'>
					{{#with A}}
					<table>
						<tr>
	            <th class="th1" colspan="5">A. DATOS DEL ESTABLECIMIENTO Y USUARIO/ PACIENTE</th>
	          </tr>
	    			<tr>
							<th class="th2">INSTITUCIÓN DEL SISTEMA</th>
							<th class="th2">ESTABLECIMIENTO DE SALUD</th>
							<th class="th2">UNICÓDIGO</th>
							<th class="th2">NÚMERO DE HISTORIA CLÍNICA ÚNICA</th>
							<th class="th2">NÚMERO DE ARCHIVO</th>
	    			</tr>
						<tr>
							<td>{{institucion_sistema}}</td>
							<td>{{establecimiento_salud}}</td>
							<td>{{unicodigo}}</td>
							<td>{{numero_historia_clinica}}</td>
							<td>{{numero_archivo}}</td>
						</tr>
	    		</table>
					{{/with}}
				</div>

				<div class='document__admision__b'>
					{{#with B}}
	    		<table>
						<tr>
	            <th class="th1" colspan="2">B. REGISTRO DE ADMISIÓN</th>
	          </tr>
	    			<tr>
							<th class="th2">FECHA DE ADMISIÓN</th>
							<th class="th2">NOMBRE Y APELLIDO DEL ADMISIONISTA</th>
	    			</tr>
	    			<tr>
							<td>{{fecha_admision}}</td>
							<td>{{nombre_apellido_admisionista}}</td>
	    			</tr>
	    		</table>
					{{/with}}
				</div>

				<div class='document__admision__c'>
					{{#with C}}
	    		<table>
	    			<tr>
	            <th class="th1" colspan="8">C. DATOS PERSONALES DEL USUARIO</th>
	          </tr>
						<tr>
							<th class="th2">PRIMER APELLIDO</th>
							<th class="th2">SEGUNDO APELLIDO</th>
							<th class="th2">PRIMER NOMBRE</th>
							<th class="th2">SEGUNDO NOMBRE</th>
							<th class="th2" colspan="4">TIPO DE IDENTIFICACION</th>
						</tr>
						<tr>
							<td>{{primer_apellido}}</td>
							<td>{{segundo_apellido}}</td>
							<td>{{primer_nombre}}</td>
							<td>{{segundo_nombre}}</td>
							<td colspan="4">{{identificacion}}</td>
						</tr>
						<tr>
							<th class="th2">ESTADO CIVIL</th>
							<th class="th2">SEXO</th>
							<th class="th2">N° TELÉFONO</th>
							<th class="th2">N° TELÉFONO CELULAR</th>
							<th class="th2" colspan="4">CORREO ELECTRÓNICO</th>
						</tr>
						<tr>
							<td>{{estado_civil}}</td>
							<td>{{sexo}}</td>
							<td>{{telefono}}</td>
							<td>{{celular}}</td>
							<td colspan="4">{{correo_electronico}}</td>
						</tr>
						<tr>
							<th class="th2" rowspan="2">FECHA NACIMIENTO</th>
							<th class="th2" rowspan="2">LUGAR DE NACIMIENTO</th>
							<th class="th2" rowspan="2">NACIONALIDAD</th>
							<th class="th2" rowspan="2">EDAD</th>
							<th class="th2" colspan="4">CONDICION DE EDAD</th>
						</tr>
						<tr>
							<th class="th2">H</th>
							<th class="th2">D</th>
							<th class="th2">M</th>
							<th class="th2">A</th>
						</tr>
						<tr>
							<td>{{fecha_nacimiento}}</td>
							<td>{{lugar_nacimiento}}</td>
							<td>{{nacionalidad}}</td>
							<td>{{edad}}</td>
							<td>{{#if condicion_edad.h}}X{{/if}}</td>
							<td>{{#if condicion_edad.d}}X{{/if}}</td>
							<td>{{#if condicion_edad.m}}X{{/if}}</td>
							<td>{{#if condicion_edad.a}}X{{/if}}</td>
						</tr>
						<tr>
							<th class="th2" rowspan="4">RESIDENCIA HABITUAL</th>
							<th class="th2">PROVINCIA</th>
							<th class="th2">CANTÓN</th>
							<th class="th2">PARROQUIA</th>
							<th class="th2" colspan="4">BARRIO O SECTOR</th>
						</tr>
						<tr>
							<td>{{provincia}}</td>
							<td>{{canton}}</td>
							<td>{{parroquia}}</td>
							<td colspan="4">{{sector}}</td>
						</tr>
						<tr>
							<th class="th2" colspan="2">CALLE PRINCIPAL</th>
							<th class="th2">CALLE SECUNDARIA</th>
							<th class="th2" colspan="4">REFERENCIA</th>
						</tr>
						<tr>
							<td colspan="2">{{calle_principal}}</td>
							<td>{{calle_secundaria}}</td>
							<td colspan="4">{{referencia}}</td>
						</tr>
						<tr>
							<th class="th2" colspan="2">AUTOIDENTIFICACIÓN ÉTNICA</th>
							<th class="th2"> NACIONALIDAD</th>
							<th class="th2"> PUEBLOS</th>
							<th class="th2" colspan="4">NIVEL DE EDUCACIÓN</th>
						</tr>
						<tr>
							<td colspan="2">{{autoidentificacion_etnica}}</td>
							<td>{{nacionalidad_etnica}}</td>
							<td>{{pueblos}}</td>
							<td colspan="4">{{nivel_educacion}}</td>
						</tr>
						<tr>
							<th class="th2">ESTADO DE EDUCACIÓN</th>
							<th class="th2">OCUPACIÓN / PROFESIÓN</th>
							<th class="th2">EMPRESA DE TRABAJO</th>
							<th class="th2">SEGURO SALUD</th>
							<th class="th2" colspan="4">TIPO DE BONO</th>
						</tr>
						<tr>
							<td>{{estado_educacion}}</td>
							<td>{{ocupacion}}</td>
							<td>{{empresa_trabajo}}</td>
							<td>{{seguro_salud}}</td>
							<td colspan="4">{{tipo_bono}}</td>
						</tr>
	    		</table>
						<tr>
							<th>*Aplica únicamente para nacionalidad étnica Kichwa</th>
						</tr>
					{{/with}}
				</div>

				<div class='document__admision__d'>
					{{#with D}}
					<table>
	    			<tr>
	            <th class="th1" colspan="4">D. DATOS DE CONTACTO</th>
	          </tr>
						<tr>
							<th class="th2">EN CASO NECESARIO LLAMAR A:</th>
							<th class="th2">PARENTESCO</th>
							<th class="th2">DIRECCIÓN </th>
							<th class="th2">N° TELÉFONO</th>
						</tr>
	    		<tr>
	    			<td>{{llamar_a}}</td>
	    			<td>{{parentesco}}</td>
	    			<td>{{direccion}}</td>
	    			<td>{{telefono}}</td>
	    		</tr>
					{{/with}}
	    </table>
				</div>

				<div class='document__admision__e'>
  				{{#with E}}
  					<table>
    					<tr>
      					<th class="th1" colspan="7">E. REGISTRO DE CAMBIOS</th>
    					</tr>

    				{{#each items}}
    					<tr>
								<th class="th4" rowspan="6">{{n}}</th>
								<th class="th2">FECHA DE REGISTRO</th>
								<th class="th2">ESTADO CIVIL</th>
								<th class="th2">NIVEL EDUCACION</th>
								<th class="th2">EMPRESA</th>
								<th class="th2">OCUPACION</th>
								<th class="th2">SEGURO</th>
    					</tr>
							<tr>
								<td>{{fecha_registro}}</td>
								<td>{{estado_civil}}</td>
								<td>{{nivel_educacion}}</td>
								<td>{{empresa}}</td>
								<td>{{ocupacion}}</td>
								<td>{{seguro}}</td>
							</tr>
							<tr>
								<th class="th2" rowspan="4">RESIDENCIA HABITUAL</th>
								<th class="th2">PROVINCIA</th>
								<th class="th2">CANTON</th>
								<th class="th2">PARROQUIA</th>
								<th class="th2">BARRIO</th>
								<th class="th2">N° TELEFONO</th>
							</tr>
							<tr>
								<td>{{residencia.provincia}}</td>
								<td>{{residencia.canton}}</td>
								<td>{{residencia.parroquia}}</td>
								<td>{{residencia.barrio}}</td>
								<td>{{residencia.telefono}}</td>
							</tr>
							<tr>
								<th class="th2" colspan="2">CALLE PRINCIPAL</th>
								<th class="th2" colspan="2">CALLE SECUNDARIA</th>
								<th class="th2">REFERENCIA</th>
							</tr>
							<tr>
								<td colspan="2">{{residencia.calle_principal}}</td>
								<td colspan="2">{{residencia.calle_secundaria}}</td>
								<td >{{residencia.referencia}}</td>
							</tr>
							{{/each}}
  						</table>
  					{{/with}}
					</div>

					<div class='document__admision__f'>
  				{{#with F}}
  					<table>
    					<tr>
      					<th class="th1" colspan="17">E. EGRESO HOSPITALARIO</th>
    					</tr>
							<tr>
							<th class="th2" colspan="4">CARACTERÍSTICAS</th>
							<th class="th2" colspan="6">DIAGNÓSTICO</th>
							<th class="th2" colspan="3">CONDICION DEL EGRESO</th>
							<th class="th2" colspan="4">TRATAMIENTO</th>
						</tr>
						<tr>
							<th class="thV">NÚMERO DE ORDEN</th>
							<th class="th5">FECHA DE<br>ADMISION Y<br>EGRESO</th>
							<th class="thV">NUMERO DE DIAS DE<br>ESTADIA</th>
							<th class="th5">CÓDIGO<br>DEL<br>SERVICIO<br>(INEC)</th>

							<th class="th5">DIAGNÓSTICOS O SÍNDROMES<br>(PRINCIPAL)</th>
							<th class="th5">CIE</th>
							<th class="thV">DEFINITIVO</th>
							<th class="th5">DIAGNÓSTICOS O SINDROMES<br>(SECUNDARIO)</th>
							<th class="th5">CIE</th>
							<th class="thV">DEFINITIVO</th>
							
							<th class="thV">ALTA</th>
							<th class="thV">MUERTE MENOS DE 48<br>HORAS</th>
							<th class="thV">MUERTE MAS DE 48<br>HORAS</th>
						
							<th class="thV">CLÍNICO</th>
							<th class="th5">QUIRÚRGICO</th>
							<th class="th5">PROCEDIMIENTOS CLÍNICOS O<br>QUIRÚRGICOS<br>PRINCIPALES</th>
							<th class="th5">SELLO Y FIRMA DEL RESPONSABLE</th>
						</tr>
						{{#each items}}
						<tr>
							<th>{{numero_orden}}</th>
							<td>{{fecha_admision}}</td>
							<td>{{dias_estadia}}</td>
							<td>{{codigo_servicio_inec}}</td>

							<td>{{dx_principal.descripcion}}</td>
							<td>{{dx_principal.cie}}</td>
							<td>{{#if dx_principal.definitivo}}X{{/if}}</td>
							<td>{{dx_secundario.descripcion}}</td>
							<td>{{dx_secundario.cie}}</td>
							<td>{{#if dx_secundario.definitivo}}X{{/if}}</td>

							<td>{{#if condicion_egreso.alta}}X{{/if}}</td>
							<td>{{#if condicion_egreso.muerte_menor_48h}}X{{/if}}</td>
							<td>{{#if condicion_egreso.muerte_mayor_48h}}X{{/if}}</td>

							<td>{{#if tratamiento.clinico}}X{{/if}}</td>
							<td>{{#if tratamiento.quirurgico}}X{{/if}}</td>
							<td>{{tratamiento.procedimientos_principales}}</td>
							<td>{{tratamiento.sello_firma_responsable}}</td>
						</tr>
						{{/each}}
					</table>
					{{/with}}
				</div>

				<div class='document__admision__lista'>
  				<table class="table2">
						<tr>
							<th colspan="2">LISTA DE CATEGORIAS</th>
						</tr>
						<tr>
							<th>TIPO DE IDENTIFICACIÓN</th>
							<td class="td1">1.Cédula de Identidad o ciudadanía. 2.Pasaporte. 3.Carnet de refugiado. 4.Sin identificación</td>
						</tr>
						<tr>
							<th>ESTADO CIVIL</th>
							<td class="td1">1.Soltero. 2.Casado. 3.Divorciado.  4.Viudo. 5.Unido. 6.Unión de hecho. 7.No Registra</td>
						</tr>
						<tr>
							<th>SEXO</th>
							<td class="td1">1.Hombre. 2.Mujer.</td>
						</tr>
						<tr>
							<th>NACIONALIDAD</th>
							<td class="td1">1.Ecuatoriana. 2.Colombiana. 3.Peruana. 4.Estadounidense. 5.Venezolana. 6.Panameña. 7.Española. 8.Argentina. 9.Chilena. 10.Cubana. 11.Holandesa. 12.Mexicana. 13.Brasileña.14.Salvadoreña. 15.Canadiense. 16.Alemana.17.China.<br>18.Británica. 19. Francesa. 988.Otra.</td>
						</tr>
						<tr>
							<th>CONDICIÓN EDAD</th>
							<td class="td1">1.Horas.  2.Días. 3.Meses. 4.Años.</td>
						</tr>
						<tr>
							<th>PROVINCIA</th>
							<td class="td1">1.Azuay. 2.Bolivar. 3.Cañar. 4.Carchi. 5.Cotopaxi. 6.Chimborazo. 7.El Oro. 8.Esmeraldas. 9.Guayas. 10.Imbabura. 11. Loja. 12.Los Ríos. 13.Manabí. 14.Morona Santiago. 15.Napo. 16.Pastaza. 17.Pichincha. 18.Tungurahua.<br>19.Zamora Chinchipe. 20. Galápagos. 21.Sucumbios. 22.Orellana. 23.Santo Domingo De Los Tsáchilas. 24.Santa Elena. 90.Zona No Delimitada</td>
						</tr>
						<tr>
							<th>AUTOIDENTIFICACIÓN ÉTNICA</th>
							<td class="td1">0.No aplica. 1.Indígena. 2.Afroecuatoriano/a. 3.Negro/a. 4.Mulato/a. 5.Montubio/a. 6.Mestizo/a. 7.Blanco/a. 8.No sabe/No responde</td>
						</tr>
						<tr>
							<th>NACIONALIDAD ÉTNICA</th>
							<td class="td1">0.No aplica. 1.Achuar. 2.Awa. 3.Cofán. 4.Chachi. 5.Epera. 6.Kichwa. 7.Secoya. 8.Shuar. 9.Shiwiar. 10.Siona. 11.Tsáchila. 12.Waorani. 13.Zapara. 14.Andoa</td>
						</tr>
						<tr>
							<th>PUEBLOS<br>(solo para nacionalidad<br>étnica KICHWA)</th>
							<td class="td1">0.No aplica. 1.Chibuleo. 2.Huancavilca. 3.Karanki. 4.Kañari. 5.Kayambi. 6.Kisapincha. 7.Kitukara. 8.Manta. 9.Natabuela. 10.Otavalo. 11.Paltas. 12.Panzaleo.</td>
						</tr>
						<tr>
							<th>NIVEL DE EDUCACION</th>
							<td class="td1">0.No aplica. 1.Ninguno. 2.Inicial. 4.Educación Básica (preparatoria). 5. Educación Básica (Elemental o media). 6.Educación Básica (Superior). 7.Bachillerato. 8.Técnico Superior. 9.Tercer Nivel. 10.Cuarto Nivel. 11.Se ignora.</td>
						</tr>
						<tr>
							<th>ESTADO DE NIVEL DE EDUCACIÓN</th>
							<td class="td1">0.No aplica 1.Cursando. 2.Completa. 3.Incompleta.</td>
						</tr>
						<tr>
							<th>TIPO DE EMPRESA DE TRABAJO</th>
							<td class="td1">0.No aplica. 1.Pública. 2.Privada. 3.Ninguno.</td>
						</tr>
						<tr>
							<th>SEGURO DE SALUD PRINCIPAL</th>
							<td class="td1">0.No aporta 1.IESS General 2.IESS Campesino 3.ISSPOL  4.ISSFA  5.Privado 6.SPATT 7.Indirecto</td>
						</tr>
						<tr>
							<th>TIPO DE BONO QUE RECIBE</th>
							<td class="td1">0.Ninguno. 1.Desarrollo Humano. 2.Joaquín Gallegos. 3.Manuela Espejo. </td>
						</tr>
						</table>
				</div>
				</div>
				</main>
    <footer>
      <p>SNS-MSP / HCU-form.001/ 2021</p>
      <p> EGRESO</p>
    </footer>
</body>
</html>