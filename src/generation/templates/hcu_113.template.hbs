          <th class="th2" colspan="2">SEXO</th>
          <th class="th2" colspan="2">EDAD (AÑOS) </th>
        </tr>
        <tr>
          <td colspan="2">{{primer_apellido}}</td>
          <td colspan="2">{{segundo_apellido}}</td>
          <td colspan="2">{{primer_nombre}}</td>
          <td colspan="2">{{segundo_nombre}}</td>
          <td colspan="2">{{sexo}}</td>
          <td colspan="2">{{edad}}</td>
        </tr>
      </table>
    {{/with}}
