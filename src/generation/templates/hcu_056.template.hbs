              <th>NERVIOSO</th>
              <td>{{#if estado_animo.nervioso}}X{{/if}}</td>

              <th>MADRE</th>
              <td>{{#if referente_personal.madre}}X{{/if}}</td>
              <th>OTRO FAMILIAR</th>
              <td>{{#if referente_personal.otro_familiar}}X{{/if}}</td>
              <th>NINGUNO</th>

              <th>CLARO</th>
              <td>{{#if proyecto_vida.claro}}X{{/if}}</td>
              <th>NINGUNO</th>
            </tr>
            <tr>
              <th>CREA PREOCUPACIÓN</th>
              <td>{{#if imagen_corporal.crea_preocupacion}}X{{/if}}</td>
              <td>{{#if imagen_corporal.impide_relacion}}X{{/if}}</td>

              <th>ALEGRE</th>
              <td>{{#if estado_animo.alegre}}X{{/if}}</td>
              <th>MUY TÍMIDO</th>
              <td>{{#if estado_animo.timido}}X{{/if}}</td>
              <th>OTRO</th>
              <td>{{#if estado_animo.otro}}X{{/if}}</td>

              <th>PADRE</th>
              <td>{{#if referente_personal.padre}}X{{/if}}</td>
              <th>FUERA DEL HOGAR</th>
              <td>{{#if referente_personal.fuera_hogar}}X{{/if}}</td>
              <td>{{#if referente_personal.ninguno}}X{{/if}}</td>

              <th>CONFUSO</th>
              <td>{{#if proyecto_vida.confuso}}X{{/if}}</td>
              <td>{{#if proyecto_vida.ninguno}}X{{/if}}</td>
            </tr>
            <tr>
              <th class="th2" colspan="2">OBSERVACIONES:</th>
              <td class="td1" colspan="15">{{observaciones}}</td>
            </tr>
            </table>
          {{/with}}
        </div>

        <div class='document__atenAdoles__n'>
          {{#with N}}
          <table>
            <tr>
              <th class="th1" colspan="9">N. CONSTANTES VITALES Y ANTROPOMETRÍA</th>
            </tr>
            <tr>
              <th class="th2">TEMPERATURA (°C)</th>
              <th class="th2">PRESIÓN ARTERIAL (mmHg)</th>
              <th class="th2">PULSO / min</th>
              <th class="th2">FRECUENCIA RESPIRATORIA / min</th>
              <th class="th2">PESO (Kg)</th>
              <th class="th2">TALLA (cm)</th>
              <th class="th2">IMC (Kg/m²)</th>
              <th class="th2">PERÍMETRO CEFÁLICO (cm)</th>
              <th class="th2">PULSIOXIMETRIA (%)</th>
            </tr>
            <tr>
              <td>{{temperatura}}</td>
              <td>{{presion_arterial}}</td>
              <td>{{pulso}}</td>
              <td>{{frecuencia_respiratoria}}</td>
              <td>{{peso}}</td>
              <td>{{talla}}</td>
              <td>{{imc}}</td>
              <td>{{perimetro_cefalico}}</td>
              <td>{{pulsioximetria}}</td>
            </tr>
            </table>
          {{/with}}
        </div>

        <div class='document__atenAdoles__o'>
          {{#with O}}
          <table>
            <tr>
              <th class="th1" colspan="10">O. EXAMEN FÍSICO</th>
              <td class="td3" colspan="3">MARCAR "X" CUANDO PRESENTE PATOLOGÍA Y DESCRIBA</td>
            </tr>
            <tr>
              <th class="th2">1. ASPECTO NORMAL</th>
              <td>{{#if aspecto_normal}}X{{/if}}</td>
              <th class="th2">4. AGUDEZA AUDITIVA</th>
              <td>{{#if agudeza_auditiva}}X{{/if}}</td>
              <th class="th2">7. TÓRAX Y MAMAS</th>
              <td>{{#if torax_mamas}}X{{/if}}</td>
              <th class="th2">10. ABDOMEN</th>
              <td>{{#if abdomen}}X{{/if}}</td>
              <th class="th2">13. MIEMBROS SUPERIORES</th>
              <td>{{#if miembros_superiores}}X{{/if}}</td>
              <th class="th2" colspan="3">16. TANNER</th>
            </tr>
            <tr>
              <th class="th2">2. PIEL Y FANERAS</th>
              <td>{{#if piel_faneras}}X{{/if}}</td>
              <th class="th2">5. BOCA Y DIENTES</th>
              <td>{{#if boca_dientes}}X{{/if}}</td>
              <th class="th2">8. CARDIO PULMONAR</th>
              <td>{{#if cardio_pulmonar}}X{{/if}}</td>
              <th class="th2">11. GENITO URINARIO</th>
              <td>{{#if genito_urinario}}X{{/if}}</td>
              <th class="th2">14. MIEMBROS INFERIORES</th>
              <td>{{#if miembros_inferiores}}X{{/if}}</td>
              <th class="th2">MAMAS</th>
              <th class="th2">GENITALES</th>
              <th class="th2">VELLO PÚBICO</th>
            </tr>
            <tr>
              <th class="th2">3. AGUDEZA VISUAL</th>
              <td>{{#if agudeza_visual}}X{{/if}}</td>
              <th class="th2">6. CUELLO Y TIROIDES</th>
              <td>{{#if cuello_tiroides}}X{{/if}}</td>
              <th class="th2">9. COLUMNA VERTEBRAL</th>
              <td>{{#if columna_vertebral}}X{{/if}}</td>
              <th class="th2">12. ANO - RECTAL</th>
              <td>{{#if ano_rectal}}X{{/if}}</td>
              <th class="th2">15. NEUROLÓGICO</th>
              <td>{{#if neurologico}}X{{/if}}</td>
              <td>{{#if mamas}}X{{/if}}</td>
              <td>{{#if genitales}}X{{/if}}</td>
              <td>{{#if vello_pubico}}X{{/if}}</td>
              </tr>
              <tr>
                <th class="th2">OBSERVACIONES:</th>
                <td class="td1" colspan="12">{{observaciones}}</td>
              </tr>
              <tr>
                <td class="td1" colspan="13">{{observaciones_fisico}}</td>
              </tr>
            </table>
          {{/with}}
        </div>

        <div class='document__atenAdoles__p'>
          {{#with P}}
          <table>
            <tr>
              <th class="th1" colspan="2">P. DIAGNOSTICO</th>
              <th class="th3">CIE</th>
              <th class="th3">PRE</th>
              <th class="th3">DEF</th>

              <th class="th3" colspan="2"> </th>
              <th class="th3">CIE</th>
              <th class="th3">PRE</th>
              <th class="th3">DEF</th>
            </tr>
            <tr>
              <th class="th5">1.</th>
              <td class="td1">{{diagnostico.[0].descripcion}}</td>
              <td>{{diagnostico.[0].cie}}</td>
              <td>{{#if diagnostico.[0].pre}}X{{/if}}</td>
              <td>{{#if diagnostico.[0].def}}X{{/if}}</td>

              <th class="th5">4.</th>
              <td class="td1">{{diagnostico.[3].descripcion}}</td>
              <td>{{diagnostico.[3].cie}}</td>
              <td>{{#if diagnostico.[3].pre}}X{{/if}}</td>
              <td>{{#if diagnostico.[3].def}}X{{/if}}</td>
            </tr>
            <tr>
              <th class="th5">2.</th>
              <td class="td1">{{diagnostico.[1].descripcion}}</td>
              <td>{{diagnostico.[1].cie}}</td>
              <td>{{#if diagnostico.[1].pre}}X{{/if}}</td>
              <td>{{#if diagnostico.[1].def}}X{{/if}}</td>

              <th class="th5">5.</th>
              <td class="td1">{{diagnostico.[4].descripcion}}</td>
              <td>{{diagnostico.[4].cie}}</td>
              <td>{{#if diagnostico.[4].pre}}X{{/if}}</td>
              <td>{{#if diagnostico.[4].def}}X{{/if}}</td>
            </tr>
            <tr>
              <th class="th5">3.</th>
              <td class="td1">{{diagnostico.[2].descripcion}}</td>
              <td>{{diagnostico.[2].cie}}</td>
              <td>{{#if diagnostico.[2].pre}}X{{/if}}</td>
              <td>{{#if diagnostico.[2].def}}X{{/if}}</td>

              <th class="th5">6.</th>
              <td class="td1">{{diagnostico.[5].descripcion}}</td>
              <td>{{diagnostico.[5].cie}}</td>
              <td>{{#if diagnostico.[5].pre}}X{{/if}}</td>
              <td>{{#if diagnostico.[5].def}}X{{/if}}</td>
            </tr>
            </table>
          {{/with}}
        </div>

        <div class='document__atenAdoles__q'>
          {{#with Q}}
          <table>
            <tr>
              <th class="th1">Q. PLAN DE TRATAMIENTO</th>
              <td class="td3">DE DIAGNÓSTICO, TERAPÉUTICOS, EDUCACIONALES Y REHABILITACION</td>
            </tr>
            <tr>
              <td class="td4j" colspan="2">{{plan_tratamiento}}</td>
            </tr>
            </table>
          {{/with}}
        </div>

        <div class='document__atenAdoles__r'>
          {{#with R}}
          <table>
            <tr>
              <th class="th1" colspan="5">R. DATOS DEL PROFESIONAL RESPONSABLE</th>
            </tr>
            <tr>
              <th class="th2">FECHA<br>(aaaa-mm-dd)</th>
              <th class="th2">HORA<br>(hh:mm)</th>
              <th class="th2">PRIMER NOMBRE</th>
              <th class="th2">PRIMER APELLIDO</th>
              <th class="th2">SEGUNDO APELLIDO</th>
            </tr>
            <tr>
              <td>{{fecha}}</td>
              <td>{{hora}}</td>
              <td>{{primer_nombre}}</td>
              <td>{{primer_apellido}}</td>
              <td>{{segundo_apellido}}</td>
            </tr>
            <tr>
              <th class="th2">NÚMERO DE DOCUMENTACIÓN DE IDENTIFICACIÓN</th>
              <th class="th2" colspan="2">FIRMA</th>
              <th class="th2" colspan="2">SELLO</th>
            </tr>
            <tr>
              <td>{{identificacion}}</td>
              <td colspan="2"><img src="{{firma}}"></td>
              <td colspan="2"><img src="{{sello}}"></td>
            </tr>
            </table>
          {{/with}}
        </div>
      </div>

      </main>
    <footer>
      <p>SNS-MSP / HCU-form.056 / 2021</p>
      <p>ATENCIÓN ADOLESCENTES(<span class="page"></span>)</p>
    </footer>
  </body>
</html>