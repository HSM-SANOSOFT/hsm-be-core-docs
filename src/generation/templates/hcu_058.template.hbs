            <tr>
              <td>{{fecha_evaluacion}}</td>
              <td>{{componentes.kps}}</td>
              <td>{{componentes.barthel}}</td>
              <td>{{componentes.pfeiffer}}</td>
              <td>{{componentes.dme}}</td>
              <td>{{componentes.gijon}}</td>
              <td>{{componentes.zarit}}</td>
              <td>{{componentes.nec_espiritual}}</td>
              <td></td>
              <td></td>
              <td></td>
            </tr>
