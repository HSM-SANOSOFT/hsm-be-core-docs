<html>
  <head>
    <meta charset='UTF-8' />
	  <style>
      @page { 
        counter-reset: page 0;
      }
      body {
        background-color: white;
        color: black;
        font-size: 8px;
        font-family: arial;
        margin: 1px;
        padding: 1px;
      }
      main {
        padding-bottom: 30px;
      }
      footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0 20px;
        height: 20px;
        display: flex;
        justify-content: space-between;
        font-weight: bold;
        background-color: white;
      }
      .page::after {
        content: counter(page);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 1px;
        border: 2px solid black;
        table-layout: auto;
      }

      .table2 {
        table-layout: fixed;
      }

      img {
        max-height: 100px;
        width: auto;
      }

      td {
        min-width: 8px;
        text-align: center;
        border: 1px solid black;
        height: 8px;      
      }

      th {
        width: auto;
        text-align: center;
        border: 1px solid black;
        height: 10px;
        font-weight: bold;
        white-space: nowrap;
      }

      .th1 {
        text-align: left;
        font-size: 9px;
        background-color: #ccccff;
      }
      .th2 {
        background-color: #ccffcc;
      }

      .th3 {
        background-color: #cbf5ec;
      }
      .th4 {
        background-color: white;
        font-weight: normal;
        text-align: left;
      }
      .th5 {
        background-color: #ccffcc;
        width: 5px;
        text-align: left;
      }

      .td1 {
        text-align: left;
        /*width: max-content;*/
        white-space: nowrap;
      }

			.td2 {
				text-align: right;
				/*width: max-content;*/
				white-space: nowrap;
				background-color: #ccccff;
				width: 5px;
			}

			.td3 {
				text-align: center;
				/*width: max-content;*/
				white-space: nowrap;
				background-color: #cbf5ec;
			}

			.td3j {
        height: 20px;
        text-align: justify;
        vertical-align: top;
      }

      .td4j {
        height: 90px;
        text-align: justify;
        vertical-align: top;
      }

    .document__odont,
    .document__odont__a,
    .document__odont__b,
    .document__odont__c,
    .document__odont__d,
    .document__odont__e,
    .document__odont__f,
    .document__odont__g,
    .document__odont__h,
    .document__odont__i,
    .document__odont__j,
    .document__odont__k,
    .document__odont__l,
    .document__odont__m,
    .document__odont__n,
    .document__odont__o,
    .document__odont__p {
      width: 100%;
      margin-top: 5px;
      padding: 0;
    }

</style>
  </head>
  <body>
  <header></header>
  <main> 

  <div class='document__odont'>
    <div class='document_odont__a'>
      {{#with A}}
      <table>
        <tr>
	        <th class='th1' colspan='11'>A. DATOS DEL ESTABLECIMIENTO Y USUARIO/ PACIENTE</th>
	      </tr>
	      <tr>
	        <th class='th2' colspan='2'>INSTITUCION DEL SISTEMA</th>
	        <th class='th2'>UNICÓDIGO</th>
	        <th class='th2' colspan='2'>ESTABLECIMIENTO DE SALUD</th>
	        <th class='th2'>NÚMERO DE HISTORIA CLÍNICA</th>
	        <th class='th2'>NÚMERO DE ARCHIVO</th>
          <th class='th2' colspan='4'>No. HOJA</th>
	      </tr>
	      <tr>
	        <td colspan='2'>{{institucion_sistema}}</td>
	        <td>{{unicodigo}}</td>
	        <td colspan='2'>{{establecimiento_salud}}</td>
	        <td>{{numero_historia_clinica}}</td>
	        <td>{{numero_archivo}}</td>
          <td colspan="4">{{no_hoja}}</td>
	      </tr>
	      <tr>
	        <th class='th2' rowspan='2' colspan='2'>PRIMER APELLIDO</th>
	        <th class='th2' rowspan='2'>SEGUNDO APELLIDO</th>
	        <th class='th2' rowspan='2'>PRIMER NOMBRE</th>
	        <th class='th2' rowspan='2'>SEGUNDO NOMBRE</th>
	        <th class='th2' rowspan='2'>SEXO</th>
	        <th class='th2' rowspan='2'>EDAD</th>
	        <th class='th2' colspan='4'>CONDICION EDAD</th>
	      </tr>
	      <tr>
	        <th class='th2'>H</th>
	        <th class='th2'>D</th>
	        <th class='th2'>M</th>
	        <th class='th2'>A</th>
	      </tr>
	      <tr>
	        <td colspan='2'>{{primer_apellido}}</td>
	        <td>{{segundo_apellido}}</td>
	        <td>{{primer_nombre}}</td>
	        <td>{{segundo_nombre}}</td>
	        <td>{{sexo}}</td>
	        <td>{{edad}}</td>
	        <td>{{#if condicion_edad.h}} x {{/if}}</td>
	        <td>{{#if condicion_edad.d}} x {{/if}}</td>
	        <td>{{#if condicion_edad.m}} x {{/if}}</td>
	        <td>{{#if condicion_edad.a}} x {{/if}}</td>
	      </tr> 
      </table> 
      {{/with}}
    </div>  

		<div class='document__odont__b'>
			{{#with B}}
			<table>
				<tr>
					<th class="th1">B. MOTIVO DE CONSULTA</th>
					<th class="th5">EMBARAZADA</th>
					<th class="th2">SI</th>
					<td>{{#if embarazada.si}}X{{/if}}</td>
					<th class="th2">NO</th>
					<td>{{#if embarazada.no}}X{{/if}}</td>
				</tr>
				<tr>
					<td class="td4j" colspan="6">{{motivo_consulta}}</td>
				</tr>
			</table>
			{{/with}}
		</div>

		<div class='document__odont__c'>
			{{#with C}}
			<table>
				<tr>
					<th class="th1">C. ENFERMEDAD ACTUAL</th>
				</tr>
				<tr>
					<td class="td4j">{{enfermedad_actual}}</td>
				</tr>
			</table>
			{{/with}}
		</div>

		<div class="document__odont__d">
      {{#with D}}
	    <table>
	    	<tr>
	        <th class='th1' colspan="20">D. ANTECEDENTES PATOLÓGICOS PERSONALES</th>
	      </tr>
	      <tr>
	        <th class='th5'>1.ALERGIA ANTIBIOTICO</th>
	        <td>{{#if antibiotico}}X{{/if}}</td>
	        <th class='th5'>2.ALERGIA ANESTESIA</th>
	        <td>{{#if anestesia}}X{{/if}}</td>
	        <th class='th5'>3. HEMORRAGIAS</th>
	        <td>{{#if hemorragias}}X{{/if}}</td>
	        <th class='th5'>4.VIH/SIDA</th>
	        <td>{{#if vih_sida}}X{{/if}}</td>
	        <th class='th5'>5. TUBERCULOSIS</th>
	        <td>{{#if tuberculosis}}X{{/if}}</td>
	        <th class='th5'>6.ASMA</th>
	        <td>{{#if asma}}X{{/if}}</td>
	        <th class='th5'>7.DIABETES</th>
	        <td>{{#if diabetes}}X{{/if}}</td>
	        <th class='th5'>8.HIPERTENSIÓN ARTERIAL</th>
	        <td>{{#if hipertension_arterial}}X{{/if}}</td>
	        <th class='th5'>9. ENF.CARDIACA</th>
	        <td>{{#if enf_cardiaca}}X{{/if}}</td>
	        <th class='th5'>10.OTRO</th>
	        <td>{{#if otro}}X{{/if}}</td>
	      </tr>
	      <tr>
	        <td class='td4j'colspan="20">{{antecedentes_personales}}</td>
	      </tr>
	    </table>
      {{/with}}
		</div>

		<div class="document__odont__e">
      {{#with E}}
	    <table>
	    	<tr>
	        <th class='th1' colspan="20">E. ANTECEDENTES PATOLÓGICOS FAMILIARES</th>
	      </tr>
	      <tr>
	        <th class='th5'>1. CARDIOPATÍA</th>
	        <td>{{#if cardiopatia}}X{{/if}}</td>
	        <th class='th5'>2. HIPERTENSIÓN</th>
	        <td>{{#if hipertension}}X{{/if}}</td>
	        <th class='th5'>3. ENF. C. VASCULAR</th>
	        <td>{{#if enf_c_vascular}}X{{/if}}</td>
	        <th class='th5'>4.  ENDÓCRINO METABÓLICO</th>
	        <td>{{#if endocrino_metabolico}}X{{/if}}</td>
	        <th class='th5'>5. CÁNCER</th>
	        <td>{{#if cancer}}X{{/if}}</td>
	        <th class='th5'>6. TUBERCULOSIS</th>
	        <td>{{#if tuberculosis}}X{{/if}}</td>
	        <th class='th5'>7.  ENF. MENTAL</th>
	        <td>{{#if enf_mental}}X{{/if}}</td>
	        <th class='th5'>8. ENF. INFECCIOSA</th>
	        <td>{{#if enf_infecciosa}}X{{/if}}</td>
	        <th class='th5'>9.  MAL FORMACIÓN</th>
	        <td>{{#if mal_formacion}}X{{/if}}</td>
	        <th class='th5'>10.  OTRO</th>
	        <td>{{#if otro}}X{{/if}}</td>
	      </tr>
	      <tr>
	        <td class='td4j'colspan="20">{{descripcion_antecedentes}}</td>
	      </tr>
	    </table>
      {{/with}}
		</div>

		<div class='document__odont__f'>
			{{#with F}}
			<table>
				<tr>
					<th class="th1" colspan="8">F. CONSTANTES VITALES</th>
				</tr>
				<tr>
					<th class="th2">TEMPERATURA °C</th>
					<td>{{temperatura}}</td>
					<th class="th2">PULSO/ min.</th>
					<td>{{pulso}}</td>
					<th class="th2">FRECUENCIA RESPIRATORIA/ min.</th>
					<td>{{frecuencia_respiratoria}}</td>
					<th class="th2">PRESIÓN ARTERIAL (mmHg)</th>
					<td>{{presion_arterial}}</td>
				</tr>
			</table>
			{{/with}}
		</div>

		<div class='document__odont__g'>
			{{#with G}}
			<table>
				<tr>
					<th class="th1" colspan="20">G. EXAMEN DEL SISTEMA ESTOMATOGNÁTICO</th>
					<td class='td2'>DESCRIBIR LA PATOLOGÍA DE LA REGIÓN AFECTADA REGISTRANDO EL NÚMERO</td>
				</tr>
				<tr>
					<th class="th5">1.</th>
					<th class="th5">LABIOS</th>
					<td>{{#if labios}}X{{/if}}</td>
					<th class="th5">3.</th>
					<th class="th5">MAXILIAR SUPERIOR</th>
					<td>{{#if max_superior}}X{{/if}}</td>
					<th class="th5">5.</th>
					<th class="th5">LENGUA</th>
					<td>{{#if lengua}}X{{/if}}</td>
					<th class="th5">7.</th>
					<th class="th5">PISO DE LA BOCA</th>
					<td>{{#if piso_boca}}X{{/if}}</td>
					<th class="th5">9.</th>
					<th class="th5">GLÁNDULAS SALIVALES</th>
					<td>{{#if glan_salivales}}X{{/if}}</td>
					<th class="th5">11.</th>
					<th class="th5">A.T.M</th>
					<td>{{#if atm}}X{{/if}}</td>
					<th class="th5">13.</th>
					<th class="th5">OTROS</th>
					<td>{{#if otros}}X{{/if}}</td>
				</tr>
				<tr>
					<th class="th5">2.</th>
					<th class="th5">MEJILLAS</th>
					<td>{{#if mejillas}}X{{/if}}</td>
					<th class="th5">4.</th>
					<th class="th5">MAXILIAR INFERIOR</th>
					<td>{{#if max_inferior}}X{{/if}}</td>
					<th class="th5">6.</th>
					<th class="th5">PALADAR</th>
					<td>{{#if paladar}}X{{/if}}</td>
					<th class="th5">8.</th>
					<th class="th5">CARRILLOS</th>
					<td>{{#if carrillos}}X{{/if}}</td>
					<th class="th5">10.</th>
					<th class="th5">ORO FARINGE</th>
					<td>{{#if oro_faringe}}X{{/if}}</td>
					<th class="th5">12.</th>
					<th class="th5">GANGLIOS</th>
					<td>{{#if ganglios}}X{{/if}}</td>
				</tr>
				<tr>
					<td class="td4j" colspan="21">{{descripcion_examen}}</td>
				</tr>
			</table>
			{{/with}}
		</div>

		<div class='document__odont__h'>
  		{{#with H}}
  		<table>
    		<tr>
      		<th class='th1' colspan='21'>H. ODONTOGRAMA</th>
      		<td class='td2'>PINTAR CON: <b>AZUL</b> PARA TRATAMIENTO REALIZADO Y <b>ROJO</b> PARA PATOLOGÍA ACTUAL<br>MOVILIDAD Y RECESIÓN: MARCAR (1, 2, 3 ó 4). SI APLICA</td>
    		</tr>
    
    		<tr>
      		<td class="td3" colspan="2">RECESIÓN</td>
      			{{#each upperTeeth}}
      		<td>{{../recesion.[this]}}</td>
      			{{/each}}
    		</tr>
    
    		<tr>
      		<td class="td3" colspan="2">MOVILIDAD</td>
      			{{#each upperTeeth}}
      		<td>{{../movilidad.[this]}}</td>
      			{{/each}}
    		</tr>

    		<tr>
      		<td colspan="2"></td>
      			{{#each upperTeeth}}
      		<td>{{this}}</td>
      			{{/each}}
    		</tr>

    		<tr>
      		<td colspan="2"></td>
      			{{#each upperTeeth}}
      		<td>imagen</td>
      			{{/each}}
    		</tr>

				<tr>
					<td colspan="2"></td>
					<td>9</td>
					<td></td>
					{{#each upperMolars}}
					<td>{{this}}</td>
					{{/each}}
					<td></td>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
				</tr>

    {{!-- Fila de molares superiores --}}
    <tr>
      <td colspan="2"></td>
      <td></td>
      <td></td>
      {{#each upperMolars}}
      <td>⊕</td>
      {{/each}}
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>

    {{!-- Espaciador --}}
    <tr>
      <td colspan="22"></td>
    </tr>

    {{!-- Fila de molares inferiores --}}
    <tr>
      <td class="td2"></td>
      <td></td>
      <td></td>
      {{#each lowerMolars}}
      <td>⊕</td>
      {{/each}}
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>

    {{!-- Fila de números de molares inferiores --}}
    <tr>
      <td class="td2"></td>
      <td></td>
      <td></td>
      {{#each lowerMolars}}
      <td>{{this}}</td>
      {{/each}}
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>

    {{!-- Fila de diagramas de dientes inferiores --}}
    <tr>
      <td class="td2"></td>
      {{#each lowerTeeth}}
      <td>◣</td>
      {{/each}}
    </tr>

    {{!-- Fila de números de dientes inferiores --}}
    <tr>
      <td class="td2"></td>
      {{#each lowerTeeth}}
      <td>{{this}}</td>
      {{/each}}
    </tr>

    {{!-- Fila de MOVILIDAD inferior --}}
    <tr>
      <td class="td2">MOVILIDAD</td>
      {{#each lowerTeeth}}
      <td>{{../movilidad.[this]}}</td>
      {{/each}}
    </tr>
    
    {{!-- Fila de RECESIÓN inferior --}}
    <tr>
      <td class="td2">RECESIÓN</td>
      {{#each lowerTeeth}}
      <td>{{../recesion.[this]}}</td>
      {{/each}}
    </tr>
  </table>
  {{/with}}
		</div>

    <div class='document__odont__i'>
			{{#with I}}
			<table class="table2">
				<tr>
					<td>
						<table>
				<tr>
					<th class='th1' colspan="2">I. INDICADORES DE SALUD BUCAL</th>
				</tr>
				<tr>
          <td>
            <table>
              <tr>
                <th class='th2' colspan="9">HIGIENE ORAL SIMPLIFICADA</th>
