		    			</tr>
							<tr>
					      <th class='th2' rowspan="2">D</th>
								<th class='th2'>C</th>
								<th class='th2'>P</th>
								<th class='th2'>O</th>
								<th class='th2'>TOTAL</th>
							</tr>
							<tr>
								<td>{{D.C}}</td>
								<td>{{D.D}}</td>
								<td>{{D.O}}</td>
								<td>{{D.total_D}}</td>
							</tr>
							<tr>
					      <th class='th2' rowspan="2">d</th>
								<th class='th2'>c</th>
								<th class='th2'>e</th>
								<th class='th2'>o</th>
								<th class='th2'>TOTAL</th>
							</tr>
							<tr>
								<td>{{d.c}}</td>
								<td>{{d.e}}</td>
								<td>{{d.o}}</td>
								<td>{{d.total_d}}</td>
							</tr>
							</table>
							{{/with}}
			    </td>
				</tr>
