						<td class="td1">{{prescripciones}}</td>
						<th><img src='{{firma}}'/></th>
	        </tr>
					<tr>
	          <th class='th2'>FECHA</th>
						<td></td>
						<td></td>
						<td></td>
						<th class='th2'>SELLO</th>
	        </tr>
					<tr>
	          <th class="td3j">{{fecha}}</th>
						<td class="td1">{{diagnostico_fecha}}</td>
						<td class="td1">{{descripcion_procedimiento}}</td>
						<td class="td1">{{descripcion_prescripcion}}</td>
						<th><img src='{{sello}}'/></th>
	        </tr>
				</table>
				{{/with}}
		</div>

	</div>
    <div>
      <footer>
        <p>SNS-MSP / HCU-form.033/2021</p>
        <p>ODONTOLOGÍA (1)</p>
      </footer>
</div>
