						<th class='th2'>PROCEDIMIENTOS</th>
						<th class='th2'>PRESCRIPCIONES</th>
						<th class='th2'>FIRMA Y SELLO</th>
	        </tr>
					<tr>
	          <th class='th2'>No.SESIÓN</th>
						<td></td>
						<td></td>
						<td></td>
						<th class='th2'>FIRMA</th>
	        </tr>
					<tr>
	          <th class="td3j">{{no_sesion}}</th>
