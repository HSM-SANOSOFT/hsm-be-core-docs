					</table>
		</div>

		<div class='document__odont__l'>
			{{#with L}}
			<table>
				<tr>
					<th class="th1">L. PEDIDO DE EXÁMENES COMPLEMENTARIOS</th>
				</tr>
				<tr>
					<td class="td4j">{{motivo_consulta}}</td>
				</tr>
				</table>
				{{/with}}
		</div>

		<div class='document__odont__m'>
			{{#with M}}
			<table class="table2">
				<tr>
					<th class="th1" colspan="9">M. INFORME DE EXÁMENES</th>
				</tr>
				<tr>
					<th class="th2">BIOMETRÍA</th>
					<td>{{#if biometria}}X{{/if}}</td>
					<th class="th2">QUÍMICA SANGUÍNEA</th>
					<td>{{#if quimica_sanguinea}}X{{/if}}</td>
					<th class="th2">RAYOS - X</th>
					<td>{{#if rayos_x}}X{{/if}}</td>
					<th class="th2">OTROS</th>
					<td>{{#if otros}}X{{/if}}</td>
					<td>{{descripcion_otros}}</td>
				</tr>
				<tr>
					<td class="td4j" colspan="9">{{informe_examen}}</td>
				</tr>
				</table>
				{{/with}}
