								<th class='th2' colspan="2">TIPOS DE OCLUSIÓN</th>
								<th class='th2' colspan="2">NIVEL DE FLUOROSIS</th>
              </tr>
              <tr>
                <th class='th3' rowspan="2"  colspan="6">PIEZAS DENTALES EXAMINADAS</th>
                <th class='th3'>PLACA</th>
								<th class='th3'>CÁLCULO</th>
                <th class='th3'>GINGIVITIS</th>
								<th class='th3'>LEVE</th>
								<td>{{#if higiene_oral.periodontal.leve}}X{{/if}}</td>
								<th class='th3'>ANGLE I</th>
								<td>{{#if higiene_oral.oclusion.angleI}}X{{/if}}</td>
								<th class='th3'>LEVE</th>
								<td>{{#if higiene_oral.fluorosis.leve}}X{{/if}}</td>
              </tr>
							<tr>
								<td class='td3'>0-1-2-3-9</td>
								<td class='td3'>0-1-2-3</td>
								<td class='td3'>0-1</td>
								<th class='th3'>MODERADA</th>
								<td>{{#if higiene_oral.periodontal.moderada}}X{{/if}}</td>
								<th class='th3'>ANGLE II</th>
								<td>{{#if higiene_oral.oclusion.angleII}}X{{/if}}</td>
								<th class='th3'>MODERADA</th>
								<td>{{#if higiene_oral.fluorosis.moderada}}X{{/if}}</td>
            	</tr>
							<tr>
								<th class='th3'>16</th>
								<td>{{#if higiene_oral.piezas_dentales.p16}}X{{/if}}</td>
								<th class='th3'>17</th>
								<td>{{#if higiene_oral.piezas_dentales.p17}}X{{/if}}</td>
								<th class='th3'>55</th>
								<td>{{#if higiene_oral.piezas_dentales.p55}}X{{/if}}</td>
								<td>{{higiene_oral.piezas_dentales.placa1}}</td>
								<td>{{higiene_oral.piezas_dentales.calculo1}}</td>
								<td>{{higiene_oral.piezas_dentales.gingivitis1}}</td>
								<th class='th3'>SEVERA</th>
								<td>{{#if higiene_oral.periodontal.severa}}X{{/if}}</td>
								<th class='th3'>ANGLE III</th>
								<td>{{#if higiene_oral.oclusion.angleIII}}X{{/if}}</td>
								<th class='th3'>SEVERA</th>
								<td>{{#if higiene_oral.fluorosis.severa}}X{{/if}}</td>
            	</tr>
							<tr>
								<th class='th3'>11</th>
								<td>{{#if higiene_oral.piezas_dentales.p11}}X{{/if}}</td>
								<th class='th3'>21</th>
								<td>{{#if higiene_oral.piezas_dentales.p21}}X{{/if}}</td>
								<th class='th3'>51</th>
								<td>{{#if higiene_oral.piezas_dentales.p51}}X{{/if}}</td>
								<td>{{higiene_oral.piezas_dentales.placa2}}</td>
								<td>{{higiene_oral.piezas_dentales.calculo2}}</td>
								<td>{{higiene_oral.piezas_dentales.gingivitis2}}</td>
							</tr>
							<tr>
								<th class='th3'>26</th>
								<td>{{#if higiene_oral.piezas_dentales.p26}}X{{/if}}</td>
								<th class='th3'>27</th>
								<td>{{#if higiene_oral.piezas_dentales.p27}}X{{/if}}</td>
								<th class='th3'>65</th>
								<td>{{#if higiene_oral.piezas_dentales.p65}}X{{/if}}</td>
								<td>{{higiene_oral.piezas_dentales.placa3}}</td>
								<td>{{higiene_oral.piezas_dentales.calculo3}}</td>
								<td>{{higiene_oral.piezas_dentales.gingivitis3}}</td>
							</tr>
							<tr>
								<th class='th3'>31</th>
								<td>{{#if higiene_oral.piezas_dentales.p31}}X{{/if}}</td>
								<th class='th3'>41</th>
								<td>{{#if higiene_oral.piezas_dentales.p41}}X{{/if}}</td>
								<th class='th3'>71</th>
								<td>{{#if higiene_oral.piezas_dentales.p71}}X{{/if}}</td>
								<td>{{higiene_oral.piezas_dentales.placa4}}</td>
								<td>{{higiene_oral.piezas_dentales.calculo4}}</td>
								<td>{{higiene_oral.piezas_dentales.gingivitis4}}</td>
							</tr>
							<tr>
								<th class='th3'>46</th>
								<td>{{#if higiene_oral.piezas_dentales.p46}}X{{/if}}</td>
								<th class='th3'>47</th>
								<td>{{#if higiene_oral.piezas_dentales.p47}}X{{/if}}</td>
								<th class='th3'>85</th>
								<td>{{#if higiene_oral.piezas_dentales.p85}}X{{/if}}</td>
								<td>{{higiene_oral.piezas_dentales.placa5}}</td>
								<td>{{higiene_oral.piezas_dentales.calculo5}}</td>
								<td>{{higiene_oral.piezas_dentales.gingivitis5}}</td>
							</tr>
							<tr>
								<th class='th2' colspan="6">TOTALES</th>
								<td>{{higiene_oral.piezas_dentales.total_placa}}</td>
								<td>{{higiene_oral.piezas_dentales.total_calculo}}</td>
								<td>{{higiene_oral.piezas_dentales.total_gingivitis}}</td>
							 </tr>
        			</table>
      			</td>
    			</tr>
  			</table>
  		{{/with}}
		</div>

	<div class='document__odont__j'>
