<html>
  <head>
    <meta charset='UTF-8' />
    <style>
      @page {
        counter-reset: page 0;
      }
      body {
        background-color: white;
        color: black;
        font-size: 8px;
        font-family: arial;
        margin: 1px;
        padding: 1px;
      }
      main {
        padding-bottom: 30px;
      }
      footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0 20px;
        height: 20px;
        display: flex;
        justify-content: space-between;
        font-weight: bold;
        background-color: white;
      }
      .page::after {
        content: counter(page);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 1px;
        border: 2px solid black;
        table-layout: fixed;
      }

      .table2 {
        table-layout: fixed;
      }
      img {
        max-height: 100px;
        width: auto;
      }

      td {
        width: 100%;
        text-align: center;
        border: 1px solid black;
        height: 10px;
      }

      th {
        width: 100%;
        text-align: center;
        border: 1px solid black;
        height: 10px;
        font-weight: bold;
      }

      .th1 {
        text-align: left;
        font-size: 9px;
        background-color: #ccccff;
      }
      .th2 {
        background-color: #ccffcc;
      }

      .th3 {
        width: 5px;
      }
      .th4 {
        background-color: white;
        font-weight: normal;
        text-align: left;
      }
      .th5 {
        background-color: #ccffcc;
        width: 5px;
      }

      .td1 {
        text-align: left;
        width: fit-content;
        white-space: nowrap;
      }

      .td2 {
        text-align: center;
        width: fit-content;
        white-space: nowrap;
        background-color: #ccffcc;
      }

      .td3 {
        text-align: left;
        width: 5px;
      }

      .td4 {
        text-align: justify;
      }

      .td4j {
        height: 90px;
        text-align: justify;
        vertical-align: top;
      }

      .document__sol__sang,
      .document__sol__sang__a,
      .document__sol__sang__b,
      .document__sol__sang__c,
      .document__sol__sang__d,
      .document__sol__sang__e,
      .document__sol__sang__f,
      .document__sol__sang__f__t {
        width: 100%;
        margin-top: 5px;
        padding: 0;
      }

    </style>
        </head>
        <body>
    <header></header>
    <main>

  <div class='document__sol__sang'>
    <div class='document__sol__sang__a'>
      {{#with A}}
        <table>
          <tr>
            <th class="th1" colspan="10">A. DATOS DEL ESTABLECIMIENTO Y USUARIO</th>
          </tr>
          <tr>
            <th class="th2" colspan="2">INSTITUCIÓN DEL SISTEMA</th>
            <th class="th2" colspan="2">UNICÓDIGO</th>
            <th class="th2" colspan="2">ESTABLECIMIENTO DE SALUD</th>
            <th class="th2" colspan="2">NÚMERO DE HISTORIA CLÍNICA ÚNICA</th>
            <th class="th2" colspan="4">NÚMERO DE ARCHIVO</th>
          </tr>
          <tr>
            <td colspan="2">{{institucion_sistema}}</td>
            <td colspan="2">{{unicodigo}}</td>
            <td colspan="2">{{establecimiento_salud}}</td>
            <td colspan="2">{{numero_historia_clinica}}</td>
            <td colspan="5">{{numero_archivo}}</td>
          </tr>
          <tr>
            <th class="th2" rowspan="2">PRIMER APELLIDO</th>
            <th class="th2" rowspan="2">SEGUNDO APELLIDO</th>
            <th class="th2" rowspan="2">PRIMER NOMBRE</th>
            <th class="th2" rowspan="2">SEGUNDO NOMBRE</th>
            <th class="th2" rowspan="2">SEXO</th>
            <th class="th2" rowspan="2">EDAD</th>
            <th class="th2" colspan="4">CONDICIÓN EDAD</th>
          </tr>
          <tr>
            <th class="th2">H</th>
            <th class="th2">D</th>
            <th class="th2">M</th>
            <th class="th2">A</th>
          </tr>
          <tr>
            <td>{{primer_apellido}}</td>
            <td>{{segundo_apellido}}</td>
            <td>{{primer_nombre}}</td>
            <td>{{segundo_nombre}}</td>
            <td>{{sexo}}</td>
            <td>{{edad}}</td>
            <td>{{#if condicion_edad.h}}X{{/if}}</td>
            <td>{{#if condicion_edad.d}}X{{/if}}</td>
            <td>{{#if condicion_edad.m}}X{{/if}}</td>
            <td>{{#if condicion_edad.a}}X{{/if}}</td>
          </tr>
        </table>
      {{/with}}
    </div>

    <div class='document__sol__sang__b'>
      {{#with B}}
        <table>
          <tr>
            <th class="th1" colspan="12">B. SERVICIO Y PRIORIDAD DE ATENCIÓN</th>
          </tr>
          <tr>
            <th class="th2" colspan="2">DIAGNÓSTICO PRINCIPAL</th>
            <th class="th2">CIE</th>
            <th class="th2" colspan="6">SERVICIO</th>
            <th class="th2">ESPECIALIDAD</th>
            <th class="th2">SALA</th>
            <th class="th2">CAMA</th>
          </tr>
          <tr>
            <td class="td1" colspan="2">{{diagnostico_principal}}</td>
            <td class="td1">{{cie}}</td>
            <th class="th5">EMERGENCIA</th>
            <td>{{#if servicio.emergencia}}X{{/if}}</td>
            <th class="th5">CONSULTA EXTERNA</th>
            <td>{{#if servicio.consulta_externa}}X{{/if}}</td>
            <th class="th5">HOSPITALIZACIÓN</th>
            <td>{{#if servicio.hospitalizacion}}X{{/if}}</td>
            <td class="td1">{{especialidad}}</td>
            <td class="td1">{{sala}}</td>
            <td class="td1">{{cama}}</td>
          </tr>
          <tr>
            <th class="th5" colspan="2">DIAGNÓSTICO PARA TRANSFUSIÓN</th>
            <td class="td1" colspan="7">{{diagnostico_transfusion}}</td>
            <th class="th2">CIE</th>
            <td class="td1" colspan="2">{{cie_transfusion}}</td>
          </tr>
          <tr>
            <th class="th5" colspan="4">CATEGORIZACIÓN DEL PACIENTE</th>
            <th class="th5" colspan="3" rowspan="3">PRIORIDAD DE LA SOLICITUD</th>
            <td class="td2">EMERGENCIA (5min)</td>
            <td>{{#if prioridad.emergencia_5min}}X{{/if}}</td>
            <th class="th2" colspan="2">ALISTAR</th>
            <td>{{#if alistar}}X{{/if}}</td>
          </tr>
          <tr>
            <td class="td2">CLÍNICO</td>
            <td>{{#if categorizacion.clinico}}X{{/if}}</td>
            <td class="td2">NEONATOLÓGICO</td>
            <td>{{#if categorizacion.neonatologico}}X{{/if}}</td>
            <td class="td2">URGENCIA (15 min)</td>
            <td>{{#if prioridad.urgencia_15min}}X{{/if}}</td>
            <td class="td2">FECHA</td>
            <td colspan="2">{{fecha}}</td>
          </tr>
          <tr>
            <td class="td2">QUIRÚRGICO</td>
            <td>{{#if categorizacion.quirurgico}}X{{/if}}</td>
            <td class="td2">GINECO - OBSTÉTRICO</td>
            <td>{{#if categorizacion.gineco_obst}}X{{/if}}</td>
            <td class="td2">RUTINA (45 min)</td>
            <td>{{#if prioridad.rutina_45min}}X{{/if}}</td>
            <td class="td2">HORA</td>
            <td colspan="2">{{hora}}</td>
          </tr>
          <tr>
            <th colspan="4">TRATAMIENTO TERAPEUTICO (ESPECIFIQUE NOMBRE Y TIEMPO DE ADMINISTRACIÓN):</th>
            <td class="td1" colspan="8">{{tratamiento}}</td>
          </tr>
        </table>
      {{/with}}
    </div>

    <div class='document__sol__sang__c'>
      {{#with C}}
        <table>
		      <tr>
            <th class="th1" colspan="25">C. ANTECEDENTES TRANSFUSIONALES</th>
		      </tr>
		      <tr>
			      <th class="th2" colspan="6">TRANSFUSIONES ANTERIORES</th>
			      <th class="th2" colspan="10">TIEMPO DE LA TRANSFUSIÓN ANTERIOR</th>
			      <th class="th2" colspan="9">REACCIONES ADVERSAS TRANSFUSIONALES PREVIAS</th>
		      </tr>
		      <tr>
			      <td class="td2">SI</td>
			      <td>{{#if trans_anter.si}}X{{/if}}</td>
			      <td class="td2">NO</td>
			      <td>{{#if trans_anter.no}}X{{/if}}</td>
			      <td class="td2">NO<br> SABE</td>
			      <td>{{#if trans_anter.no_sabe}}X{{/if}}</td>
			      <td class="td2">< DE 2<br>MESES</td>
			      <td>{{#if T_trans_anter.menor_2meses}}X{{/if}}</td>
			      <td class="td2">3-5<br>MESES</td>
			      <td>{{#if T_trans_anter.entre_3a5m}}X{{/if}}</td>
			      <td class="td2">6-8<br>MESES</td>
			      <td>{{#if T_trans_anter.entre_6a8m}}X{{/if}}</td>
			      <td class="td2">9-12<br>MESES</td>
			      <td>{{#if T_trans_anter.entre_9a12m}}X{{/if}}</td>
			      <td class="td2">> 12<br>MESES</td>
			      <td>{{#if T_trans_anter.mayor_12m}}X{{/if}}</td>
			      <td class="td2">SI</td>
			      <td>{{#if reac_prev.si}}X{{/if}}</td>
			      <td >ESPECIFIQUE:</td>
			      <td colspan="2">{{reac_prev.especifique}}</td>
			      <td class="td2">NO</td>
			      <td>{{#if reac_prev.no}}X{{/if}}</td>
			      <td class="td2">NO<br>SABE</td>
			      <td>{{#if reac_prev.no_sabe}}X{{/if}}</td>
		      </tr>
	      </table>
      {{/with}}
    </div>

    <div class='document__sol__sang__d'>
      {{#with D}}
	      <table>
		      <tr>
			      <th class="th1" colspan="18">D. DATOS ACTUALES DE LABORATORIO</th>
		      </tr>
		      <tr>
            <th>HEMOGLOBINA</th>
            <td colspan="2">{{hemoglobina}}</td>
            <th>HEMATOCRITO</th>
            <td colspan="2">{{hemotocrito}}</td>
            <th>PLAQUETAS</th>
            <td colspan="2">{{plaquetas}}</td>
            <th>TP</th>
            <td colspan="2">{{tp}}</td>
            <th>TTP</th>
            <td colspan="2">{{ttp}}</td>
            <th>GRUPO ABO/RH</th>
            <td colspan="2">{{grupo_abo}}</td>
		      </tr>
		      <tr>
            <th>INR</th>
            <td colspan="2">{{inr}}</td>
            <th>OTROS:</th>
            <td class="td1" colspan="14">{{otros}}</td>
		      </tr>
	      </table>
      {{/with}}
    </div>

    <div class='document__sol__sang__e'>
      {{#with E}}
	      <table class="table2">
		      <tr>
			      <th class="th1" colspan="8">E. TIPO Y NÚMERO DE COMPONENTES SANGUÍNEOS SOLICITADOS</th>
		      </tr>
          <tr>
            <th class="th3" colspan="2">COMPONENTE SANGUÍNEO</th>
            <th class="th3">NÚMERO</th>
            <th class="th3">LETRAS</th>
            <th class="th3" colspan="2">COMPONENTE SANGUÍNEO</th>
            <th class="th3">NÚMERO</th>
            <th class="th3">LETRAS</th>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE GLÓBULOS ROJOS ESTÁNDAR</td>
            <td class="td3">CGRE</td>
            <td>{{numero.concent_glob}}</td>
            <td>{{letras.concent_glob}}</td>
            <td class="td3">CONCENTRADO DE PLAQUETAS</td>
            <td class="td3">CP</td>
            <td>{{numero.concent_plaquetas}}</td>
            <td>{{letras.concent_plaquetas}}</td>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE GLÓBULOS ROJOS SIN CAPA LEUCOPLAQUETARIA</td>
            <td class="td3">CGRSCLp</td>
            <td>{{numero.leucoplaquetaria}}</td>
            <td>{{letras.leucoplaquetaria}}</td>
            <td class="td3">CONCENTRADO DE PLAQUETAS POR AFÉRESIS</td>
            <td class="td3">CPA</td>
            <td>{{numero.plaquetas_aferesis}}</td>
            <td>{{letras.plaquetas_aferesis}}</td>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE GLÓBULOS ROJOS LEUCORREDUCIDOS</td>
            <td class="td3">CGRL</td>
            <td>{{numero.leucorreducidos}}</td>
            <td>{{letras.leucorreducidos}}</td>
            <td class="td3">PLASMA FRESCO CONGELADO</td>
            <td class="td3">PFC</td>
            <td>{{numero.plasma_congelado}}</td>
            <td>{{letras.plasma_congelado}}</td>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE  GLÓBULOS ROJOS PEDIÁTRICOS</td>
            <td class="td3">CGRP</td>
            <td>{{numero.pediatricos}}</td>
            <td>{{letras.pediatricos}}</td>
            <td class="td3">CRIOPRECIPITADO</td>
            <td class="td3">CRIO</td>
            <td>{{numero.crioprecipitado}}</td>
            <td>{{letras.crioprecipitado}}</td>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE GLÓBULOS ROJOS PEDIÁTRICOS SIN CAPA LEUCOPLAQUETARIA</td>
            <td class="td3">CGRPSCLp</td>
            <td>{{numero.pedia_leucoplaqueteria}}</td>
            <td>{{letras.pedia_leucoplaqueteria}}</td>
            <td class="td3">PLASMA REFRIGERADO</td>
            <td class="td3">PR</td>
            <td>{{numero.plasma_refrigerado}}</td>
            <td>{{letras.plasma_refrigerado}}</td>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE GLÓBULOS ROJOS PEDIÁTRICOS LEUCORREDUCIDOS</td>
            <td class="td3">CGRPL</td>
            <td>{{numero.pedia_leucorreducidos}}</td>
            <td>{{letras.pedia_leucorreducidos}}</td>
            <td class="td3">SANGRE RECONSTITUIDA</td>
            <td class="td3">SR</td>
            <td>{{numero.sangre_reconstituida}}</td>
            <td>{{letras.sangre_reconstituida}}</td>
          </tr>
          <tr>
            <td class="td3">CONCENTRADO DE GLÓBULOS ROJOS IRRADIADOS</td>
            <td class="td3">CGRI</td>
            <td>{{numero.irradiados}}</td>
            <td>{{letras.irradiados}}</td>
            <td class="td3">OTRO:</td>
            <td></td>
            <td>{{numero.otro}}</td>
            <td>{{letras.otro}}</td>
          </tr>
	      </table>
      {{/with}}
    </div>

    <div class='document__sol__sang__f'>
      {{#with F}}
        <table>
          <tr>
            <th class="th1">F. SOLICITUD DE  COMPONENTES SANGUÍNEOS CON PRUEBAS DE COMPATIBILIDAD EN PROCESO</th>
          </tr>
          <tr>
            <td class="td4">Yo, {{nombre_persona}} en calidad de médico prescriptor de éste paciente, quien  se  encuentra  en  estado   crítico,   bajo  mi  responsabilidad  solicito  de  manera  urgente/emergente  el  (los)  componente(s)  sanguíneo(s)  antes  descrito(s),  acepto que este componente sea enviado únicamente con la determinación de grupo ABO/RH con el fin de mejorar la condición de salud del  paciente antes mencionado. 
            Además  solicito  se  completen  las puebas de compatibilidad sanguínea  correspondientes y se me informen  los resultados de los mismos una vez se hayan concluido.</td>
          </tr>
        </table>
      {{/with}}
    </div>

	  <div class='document__sol__sang__f__t'>
      {{#with F_table}}
        <table>
          <tr>
            <th class="th2">FECHA GENERACIÓN PEDIDO</th>
            <td>{{fecha_pedido}}</td>
            <th class="th2">HORA DE GENERACIÓN DEL <br>PEDIDO</th>
            <td>{{hora_pedido}}</td>
            <th class="th2">NOMBRE Y APELLIDO DEL PROFESIONAL</th>
            <td>{{nombre_apellido_prof}}</td>
            <th class="th2">FIRMA Y SELLO</th>
            <td><img src='{{firma_sello_personal}}'/></td>
          </tr>
          <tr>
            <th class="th2">FECHA DE TOMA DE MUESTRA</th>
            <td>{{fecha_muestra}}</td>
            <th class="th2">HORA DE TOMA DE MUESTRA</th>
            <td>{{hora_muestra}}</td>
            <th class="th2">NOMBRE Y APELLIDO DE LA PERSONA QUE TOMA LA MUESTRA</th>
            <td>{{nombre_apellido_prof_muestra}}</td>
            <th class="th2">FIRMA</th>
            <td><img src='{{firma_prof_muestra}}'/></td>
          </tr>
        </table>
      {{/with}}
    </div>

</div>
    </main>
    <footer>
      <p>SNS-MSP / HCU-form.118 / 2021</p>
      <p>SOLICITUD DE SANGRE</p>
    </footer>
  </body>
</html>